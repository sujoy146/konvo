NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID= add your project id from AppWrite
NEXT_PUBLIC_APPWRITE_DATABASE_ID= add your database id from AppWrite
NEXT_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID= add your profile table id from AppWrite
NEXT_PUBLIC_APPWRITE_KEYS_COLLECTION_ID= add your keys table-id from AppWrite
NEXT_PUBLIC_APPWRITE_MESSAGES_COLLECTION_ID= add your messages table-id from AppWrite
NEXT_PUBLIC_APPWRITE_SEND_MESSAGE_FUNCTION_ID= add your function id from AppWrite
